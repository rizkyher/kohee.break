{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kohee-password",
	"account_id": "1ef2e18dc9de53cb201f3ca19b77bebb",
	"main": "worker.ts",
	"compatibility_date": "2026-11-06",
