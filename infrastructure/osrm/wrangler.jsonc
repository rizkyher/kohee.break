{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kohee-routing",
	"account_id": "1ef2e18dc9de53cb201f3ca19b77bebb",
	"main": "worker.ts",
	"compatibility_date": "2026-11-06",
	"secrets": { "required": ["OSRM_TOKEN"] },
	"containers": [
		{
			"class_name": "BandungRouter",
			"image": "./cloudflare.Dockerfile",
			"image_build_context": ".",
			"instance_type": "basic",
			"max_instances": 1
		}
	],
	"durable_objects": { "bindings": [{ "name": "ROUTER", "class_name": "BandungRouter" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BandungRouter"] }],
	"ratelimits": [
		{ "name": "ROUTING_LIMIT", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }
	],
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": false },
		"traces": { "enabled": true }
	}
}
