# Copy to .env (local) or set in Cloudflare build settings. All values are public:
# they are inlined into the page at build time. Never put secrets here.

# Seller WhatsApp number, international format, digits only (country code first, no leading 0).
# Example: 6281234567890. Leave empty to keep WhatsApp ordering switched off.
WHATSAPP_NUMBER=

# Instagram username without @. Leave empty to hide the Instagram link.
INSTAGRAM_HANDLE=koheebreak

# Public origin of the deployed site, used for absolute Open Graph/link-preview URLs.
# Example: https://kohee-break.pages.dev (the live Pages domain)
SITE_URL=

# Optional pickup/delivery choices, comma separated, e.g. "Ambil sendiri,Antar (ongkir via chat)".
# Leave empty and the checkout will not ask.
FULFILLMENT_OPTIONS=
